#!/usr/bin/env sh
# mailbox — steadier hands for the file mailbox protocol.
#
# Enforces the write-side invariants of references/mailbox-protocol.md
# mechanically: sequence numbers counted from the writer's own headers,
# clock-sourced timestamps, a read cursor on every entry, a true append
# with last-header self-verification, and freshness by sequence
# comparison rather than by file timestamp.
#
# The mailbox files stay the wire format and the floor. This tool never
# repairs another side's file, never edits an entry, never deletes.
#
# Exit codes: 0 ok or mail delivered · 1 no new mail · 2 refused · 124 timeout.
set -eu

ME=${0##*/}

die() {
	printf '%s: %s\n' "$ME" "$1" >&2
	exit 2
}

usage() {
	cat >&2 <<'USAGEEOF'
usage:
  mailbox init  --home <mailbox home>
  mailbox append --as dispatcher|worker --dir <channel>
                 --disposed-through <N|none> [--file <path>]
  mailbox check --as dispatcher|worker --dir <channel>
  mailbox wait  --as worker --dir <channel> [--timeout 570]
  mailbox watch --as dispatcher|worker (--home <home> | --dir <channel>)
                 [--timeout 3600]

exit codes: 0 ok or mail delivered · 1 no new mail · 2 refused · 124 timeout
USAGEEOF
	exit 2
}

# Entry headers are `## <seq> — <role> — <ISO timestamp>`. Requiring the
# sequence number and the em dash keeps a body line that merely starts with
# "## " from being counted as an entry.
HEADER_RE='^## [0-9]+ — '

# What the READ side keys on when it hunts for a header it cannot parse: any
# level-two heading at column 0. The write guard asks this same question, from
# one constant, on purpose. A shape the writer accepts and the reader later
# refuses wedges the channel: the entry is already on disk, and from then on
# every append and every check on that file refuses, with no sanctioned
# repair. A deeper heading ("### ") matches neither side.
HEADING_RE='^## '


entry_count() {
	if [ ! -f "$1" ]; then
		printf '0\n'
		return 0
	fi
	awk -v re="$HEADER_RE" '$0 ~ re { n++ } END { print n + 0 }' "$1"
}

last_seq() {
	if [ ! -f "$1" ]; then
		printf '0\n'
		return 0
	fi
	awk -v re="$HEADER_RE" '$0 ~ re { s = $2 + 0 } END { print s + 0 }' "$1"
}

# Prints the first level-two heading at column 0 that is not a canonical
# header, or nothing. Such a line means the file was written by something
# other than this tool — an older channel shape, a hand-written entry —
# because append refuses the same shape on the way in and the indent escape
# puts a quoted heading at column 1. The counters skip what they cannot
# match, so one unreadable header makes append write a duplicate sequence
# number and the other side's check report "no new mail" over an unread
# entry. Missed mail is the failure this protocol exists to prevent, so both
# sides refuse rather than guess.
foreign_header() {
	[ -f "$1" ] || return 0
	awk -v re="$HEADER_RE" -v hre="$HEADING_RE" \
		'$0 ~ hre && $0 !~ re { print; exit }' "$1"
}

refuse_foreign_header() {
	foreign=$(foreign_header "$1")
	[ -z "$foreign" ] ||
		die "\"$1\" holds a header this tool cannot read: \"$foreign\" — its numbering cannot be trusted; stop and tell your user"
}

last_header() {
	[ -f "$1" ] || return 0
	awk -v re="$HEADER_RE" '$0 ~ re { h = $0 } END { if (h != "") print h }' "$1"
}

require_role() {
	case "$1" in
	dispatcher | worker) ;;
	*) die "--as takes dispatcher or worker (got \"$1\")" ;;
	esac
}

other_role() {
	case "$1" in
	dispatcher) printf 'worker\n' ;;
	*) printf 'dispatcher\n' ;;
	esac
}

require_seconds() {
	case "$2" in
	'' | *[!0-9]*) die "$1 takes a whole number of seconds (got \"$2\")" ;;
	esac
	# Zero means NO timeout at all to GNU timeout, which would make these
	# commands unbounded. They are bounded by contract.
	[ "$2" -gt 0 ] || die "$1 must be greater than zero — zero means no timeout at all"
}

# A timeout that rejects --foreground must fail loudly here. Dropping the flag
# is not an option: without it the timeout moves into a new process group and a
# group-directed kill reaches the wrapper but not the poll. And failing quietly
# is worse than useless, because the option error exits 1, which this contract
# reads as "no new mail" — a missing capability would impersonate a quiet
# mailbox.
require_foreground_timeout() {
	timeout --foreground 1 true >/dev/null 2>&1 ||
		die 'needs a timeout supporting --foreground (GNU coreutils); refusing rather than reporting an empty mailbox'
}

cmd_init() {
	home=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--home)
			[ $# -ge 2 ] || die '--home needs a value'
			home=$2
			shift 2
			;;
		*) die "unknown argument \"$1\" for init" ;;
		esac
	done
	[ -n "$home" ] || die 'init needs --home <mailbox home>'
	mkdir -p -- "$home" || die "cannot create mailbox home \"$home\""
	# Seed the stamp at the current time, so the first watch does not fire
	# on the freshly created files. Never touch an existing stamp: that
	# would swallow another channel's unread wake.
	if [ ! -f "$home/.dispatcher-mail-delivered" ]; then
		touch -- "$home/.dispatcher-mail-delivered"
	fi
	printf '%s\n' "$home"
}



# The read cursor lives in the writer's own entries, never in a delivery
# marker. Tolerant on purpose: entries from an older channel phrase the
# trailer slightly differently, and a read must not fail on one.
cursor_of() {
	if [ ! -f "$1" ]; then
		printf '0\n'
		return 0
	fi
	awk '
		tolower($0) ~ /disposed through/ { line = $0 }
		END {
			if (line == "") { print 0; exit }
			if (match(line, /entry[^0-9]*[0-9]+/)) {
				s = substr(line, RSTART, RLENGTH)
				sub(/^entry[^0-9]*/, "", s)
				print s + 0
			} else {
				print 0
			}
		}
	' "$1"
}

cmd_append() {
	role='' dir='' cursor='' file=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--as)
			[ $# -ge 2 ] || die '--as needs a value'
			role=$2
			shift 2
			;;
		--dir)
			[ $# -ge 2 ] || die '--dir needs a value'
			dir=$2
			shift 2
			;;
		--disposed-through)
			[ $# -ge 2 ] || die '--disposed-through needs a value'
			cursor=$2
			shift 2
			;;
		--file)
			[ $# -ge 2 ] || die '--file needs a value'
			file=$2
			shift 2
			;;
		*) die "unknown argument \"$1\" for append" ;;
		esac
	done
	[ -n "$role" ] || die 'append needs --as dispatcher|worker'
	require_role "$role"
	[ -n "$dir" ] || die 'append needs --dir <channel>'
	[ -d "$dir" ] || die "channel directory \"$dir\" does not exist"
	# What the caller has read is a claim only the caller can make, so the
	# cursor is never inferred and never optional.
	[ -n "$cursor" ] || die 'append needs --disposed-through <N|none>'
	case "$cursor" in
	none) cursor='' ;;
	*[!0-9]*) die "--disposed-through takes a number or \"none\" (got \"$cursor\")" ;;
	esac

	if [ -n "$file" ]; then
		[ -f "$file" ] || die "body file \"$file\" does not exist"
		body=$(cat -- "$file")
	else
		body=$(cat)
	fi
	[ -n "$body" ] || die 'refusing to append an empty entry'
	# Refuse BEFORE anything lands, and refuse every shape the read side
	# refuses — not only a canonically-shaped one. A body heading the writer
	# lets through fails the NEXT append and every check afterwards, with the
	# entry already in the file and no sanctioned repair: a wedged channel.
	# The format has no escape, so indent the heading by one space and it is
	# prose again, or write it as "### ".
	if printf '%s\n' "$body" | grep -Eq "$HEADING_RE"; then
		die 'refusing to append: a body line is a level-two heading ("## ...") — the read side would then refuse the whole file; indent it by one space, or deepen it to "### "'
	fi

	own=$dir/$role.md
	refuse_foreign_header "$own"
	n=$(entry_count "$own")
	last=$(last_seq "$own")
	# A gap or a duplicate in the writer's own file makes count+1 the wrong
	# next number. Refuse and let a human look — repairing is not this
	# tool's job.
	[ "$last" -eq "$n" ] ||
		die "\"$own\" is mis-numbered (last header $last, $n headers) — refusing to append"
	seq=$((n + 1))

	ts=$(date -Is 2>/dev/null) || ts=''
	[ -n "$ts" ] ||
		die 'date -Is failed — stop and tell your user; do not append by hand'

	if [ -n "$cursor" ]; then
		trailer="disposed through $(other_role "$role") entry $cursor"
	else
		trailer="disposed through $(other_role "$role") entry: none yet"
	fi
	header="## $seq — $role — $ts"

	tmp=$(mktemp) || die 'cannot create a temporary file'
	trap 'rm -f "$tmp"' EXIT INT TERM
	{
		if [ -s "$own" ]; then printf '\n'; fi
		printf '%s\n%s\n\n%s\n' "$header" "$body" "$trailer"
	} >"$tmp"
	# A true append, never an anchored edit: an edit anchor matches an
	# earlier entry's trailer and lands new mail mid-file.
	cat -- "$tmp" >>"$own" || die "append to \"$own\" failed"

	got=$(last_header "$own")
	[ "$got" = "$header" ] ||
		die "append verification failed: last header in \"$own\" is \"$got\", expected \"$header\" — inspect the file before retrying"
	printf '%s\n' "$header"
}


cmd_check() {
	role='' dir=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--as)
			[ $# -ge 2 ] || die '--as needs a value'
			role=$2
			shift 2
			;;
		--dir)
			[ $# -ge 2 ] || die '--dir needs a value'
			dir=$2
			shift 2
			;;
		*) die "unknown argument \"$1\" for check" ;;
		esac
	done
	[ -n "$role" ] || die 'check needs --as dispatcher|worker'
	require_role "$role"
	[ -n "$dir" ] || die 'check needs --dir <channel>'
	[ -d "$dir" ] || die "channel directory \"$dir\" does not exist"

	own=$dir/$role.md
	other=$dir/$(other_role "$role").md
	[ -f "$other" ] || return 1
	refuse_foreign_header "$own"
	refuse_foreign_header "$other"
	cursor=$(cursor_of "$own")
	# Freshness is the sequence comparison, never a file timestamp: a
	# timestamp can say "delivered" while an entry sits unread. The gate and
	# the printed window ask the SAME question — new mail exists exactly when
	# some entry's sequence passes the cursor — so a duplicated or a skipped
	# number can never make one of them disagree with the other.
	unread=$(awk -v re="$HEADER_RE" -v c="$cursor" '
		$0 ~ re { if (($2 + 0) > c) on = 1 }
		on { print }
	' "$other")
	[ -n "$unread" ] || return 1
	printf '%s\n' "$unread"
}


cmd_wait() {
	role='' dir='' seconds=570
	while [ $# -gt 0 ]; do
		case "$1" in
		--as)
			[ $# -ge 2 ] || die '--as needs a value'
			role=$2
			shift 2
			;;
		--dir)
			[ $# -ge 2 ] || die '--dir needs a value'
			dir=$2
			shift 2
			;;
		--timeout)
			[ $# -ge 2 ] || die '--timeout needs a value'
			require_seconds --timeout "$2"
			seconds=$2
			shift 2
			;;
		*) die "unknown argument \"$1\" for wait" ;;
		esac
	done
	[ -n "$role" ] || die 'wait needs --as worker'
	require_role "$role"
	# wait belongs to the worker. A dispatcher that blocks cannot answer,
	# and its wait would stamp the channel's marker while its watch stamps
	# the home's — two markers for one role, and a wake lost between them.
	[ "$role" = worker ] ||
		die 'wait is the worker\'"'"'s instrument — a dispatcher checks between tasks instead'
	[ -n "$dir" ] || die 'wait needs --dir <channel>'
	[ -d "$dir" ] || die "channel directory \"$dir\" does not exist"

	other=$dir/$(other_role "$role").md
	stamp=$dir/.$role-mail-delivered
	require_foreground_timeout
	# --foreground on every timeout: without it the timeout moves into a new
	# process group and a group-directed kill misses the poll.
	# The poll stamps itself at the moment it fires, never by hand, so mail
	# landing while the caller reads stays newer than the fire-time stamp.
	set +e
	# The inner script is single-quoted on purpose: its $1/$2/$3 are the
	# positional arguments passed to the inner shell below, and must not be
	# expanded by this one.
	# shellcheck disable=SC2016
	timeout --foreground "$seconds" sh -c '
		[ -f "$2" ] || touch -t 197001010000 -- "$2"
		until [ "$1" -nt "$2" ]; do sleep 15; done
		touch -- "$2"
	' mailbox-wait "$other" "$stamp"
	rc=$?
	set -e
	return "$rc"
}


cmd_watch() {
	role='' home='' dir='' seconds=3600
	while [ $# -gt 0 ]; do
		case "$1" in
		--as)
			[ $# -ge 2 ] || die '--as needs a value'
			role=$2
			shift 2
			;;
		--home)
			[ $# -ge 2 ] || die '--home needs a value'
			home=$2
			shift 2
			;;
		--dir)
			[ $# -ge 2 ] || die '--dir needs a value'
			dir=$2
			shift 2
			;;
		--timeout)
			[ $# -ge 2 ] || die '--timeout needs a value'
			require_seconds --timeout "$2"
			seconds=$2
			shift 2
			;;
		*) die "unknown argument \"$1\" for watch" ;;
		esac
	done
	[ -n "$role" ] || die 'watch needs --as dispatcher|worker'
	require_role "$role"
	if [ -n "$home" ] && [ -n "$dir" ]; then
		die 'watch takes --home or --dir, not both'
	fi
	target=$(other_role "$role").md
	stamp=.$role-mail-delivered
	# --foreground on every timeout, in both forms: without it the timeout
	# moves into a new process group and a group-directed kill misses the
	# watch. The guard initializes a missing stamp to the epoch so a
	# first-ever watch fires on mail already waiting; without it the
	# home form's find errors on the missing file and the watch is deaf.
	if [ -n "$dir" ]; then
		[ -d "$dir" ] || die "channel directory \"$dir\" does not exist"
		require_foreground_timeout
		set +e
		# The inner script is single-quoted on purpose: its $1/$2/$3 are the
		# positional arguments passed to the inner shell below, and must not be
		# expanded by this one.
		# shellcheck disable=SC2016
		timeout --foreground "$seconds" sh -c '
			cd -- "$1" || exit 2
			[ -f "$3" ] || touch -t 197001010000 -- "$3"
			until [ "$2" -nt "$3" ]; do sleep 30; done
			touch -- "$3"
		' mailbox-watch "$dir" "$target" "$stamp"
		rc=$?
		set -e
		return "$rc"
	fi
	[ -n "$home" ] || die 'watch needs --home <mailbox home> or --dir <channel>'
	[ -d "$home" ] || die "mailbox home \"$home\" does not exist"
	require_foreground_timeout
	set +e
	# The inner script is single-quoted on purpose: its $1/$2/$3 are the
	# positional arguments passed to the inner shell below, and must not be
	# expanded by this one.
	# shellcheck disable=SC2016
	timeout --foreground "$seconds" sh -c '
		cd -- "$1" || exit 2
		[ -f "$3" ] || touch -t 197001010000 -- "$3"
		until [ -n "$(find . -name "$2" -newer "$3")" ]; do sleep 30; done
		touch -- "$3"
	' mailbox-watch "$home" "$target" "$stamp"
	rc=$?
	set -e
	return "$rc"
}

[ $# -ge 1 ] || usage
cmd=$1
shift
case "$cmd" in
init) cmd_init "$@" ;;
append) cmd_append "$@" ;;
check) cmd_check "$@" ;;
wait) cmd_wait "$@" ;;
watch) cmd_watch "$@" ;;
*) usage ;;
esac
