#!/usr/bin/env sh
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$HERE/.." && pwd)
ROOT=$(readlink -f "$ROOT")
PROFILES="openai-codex ollama-cloud anthropic"

info() { printf '%s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }

# Sets $dir to the profile's agent directory, or exits. A link destination
# must never be empty or the filesystem root.
profile_dir() { # profile
  if command -v omp >/dev/null 2>&1; then
    dir=$(omp --profile "$1" config path 2>/dev/null) || fail "could not resolve OMP profile '$1'"
  else
    dir="$HOME/${PI_CONFIG_DIR:-.omp}/profiles/$1/agent"
  fi
  case $dir in
    /?*) ;;
    *) fail "OMP profile '$1' resolved to unusable directory '$dir'" ;;
  esac
}

# Resolves every profile before acting, so one unresolvable profile changes
# nothing. Then runs <shared-step> <first-agent-dir> once and
# <profile-step> <profile> <agent-dir> per profile; returns 1 if any step did.
each_profile() { # shared-step profile-step
  shared_step=$1 profile_step=$2 erc=0
  set --
  for profile in $PROFILES; do
    profile_dir "$profile"
    set -- "$@" "$profile" "$dir"
  done
  "$shared_step" "$2" || erc=1
  while [ "$#" -gt 0 ]; do
    "$profile_step" "$1" "$2" || erc=1
    shift 2
  done
  return "$erc"
}

shared_agent_dir() { # profile agent dir; sets $shared to <config-root>/agent
  config_root=$(dirname -- "$(dirname -- "$(dirname -- "$1")")")
  case $config_root in
    /?*) shared="$config_root/agent" ;;
    *) fail "cannot derive the shared agent directory from '$1'" ;;
  esac
}

link_owned() { # source dest
  src=$1 dst=$2
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    fail "$dst exists and is not a symlink; move/merge it manually"
  fi
  ln -sfn "$src" "$dst" || fail "could not link $dst -> $src"
  info "linked $dst -> $src"
}

link_config() { # profile dir
  profile=$1 dir=$2
  cfg="$dir/config.yml"
  template="$ROOT/profiles/$profile/config.yml"
  if [ -L "$cfg" ] || [ ! -e "$cfg" ]; then
    link_owned "$template" "$cfg"
    return 0
  fi
  if cmp -s "$cfg" "$template"; then
    ln -sfn "$template" "$cfg" || fail "could not link $cfg -> $template"
    info "replaced identical copy: $cfg -> $template"
    return 0
  fi
  info "WARN: $cfg differs from $template; left untouched (merge it, then rerun install)"
  return 1
}

install_profile() { # profile dir
  profile=$1 dir=$2
  mkdir -p -- "$dir" || fail "could not create $dir"
  prc=0
  for name in AGENTS.md agents rules skills extensions lib; do
    link_owned "$ROOT/agent/$name" "$dir/$name"
  done
  link_config "$profile" "$dir" || prc=1
  info "left $dir/mcp.json untouched; optional example: $ROOT/mcp.example.json"
  return "$prc"
}

install_shared() { # first profile agent dir
  shared_agent_dir "$1"
  mkdir -p -- "$shared" || fail "could not create $shared"
  link_owned "$ROOT/agent/keybindings.yml" "$shared/keybindings.yml"
}

install() {
  rc=0
  each_profile install_shared install_profile || rc=1
  [ "$rc" -eq 0 ] || info "one or more profile configs diverge from their template; nothing was overwritten"
  return "$rc"
}

verify_link() { # source dest
  src=$(readlink -f "$1")
  [ -L "$2" ] || { info "FAIL: $2 is not a symlink"; return 1; }
  dst=$(readlink -f "$2" 2>/dev/null || true)
  [ "$src" = "$dst" ] || { info "FAIL: $2 -> ${dst:-dangling}, expected $src"; return 1; }
  info "ok: $2"
}

verify_profile() { # profile dir
  profile=$1 dir=$2
  prc=0
  info "profile: $profile ($dir)"
  for name in AGENTS.md agents rules skills extensions lib; do
    verify_link "$ROOT/agent/$name" "$dir/$name" || prc=1
  done
  verify_link "$ROOT/profiles/$profile/config.yml" "$dir/config.yml" || prc=1
  return "$prc"
}

verify_shared() { # first profile agent dir
  shared_agent_dir "$1"
  verify_link "$ROOT/agent/keybindings.yml" "$shared/keybindings.yml"
}

verify() {
  each_profile verify_shared verify_profile
}

doctor_profile() { # profile dir
  profile=$1 dir=$2
  cfg="$dir/config.yml"
  [ -f "$cfg" ] || fail "$cfg not found"

  info "profile: $profile"
  info "config: $cfg"
  if grep -q 'ai-stack/.*/flow-skills\.ts\|ai-stack/omp/extensions/flow-skills\.ts' "$cfg"; then
    info "WARN: remove old ai-stack flow-skills.ts registration"
  else
    info "ok: no old flow-skills.ts registration"
  fi
  if grep -q 'ai-stack/shared/skills' "$cfg"; then
    info "WARN: remove old skills.customDirectories entry pointing at ai-stack/shared/skills"
  else
    info "ok: no old ai-stack shared-skills registration"
  fi
  if grep -q 'ai-stack/omp/extensions/ai-memory\.ts' "$cfg"; then
    info "WARN: explicit old ai-memory.ts path is redundant; native extensions/ auto-discovery owns it now"
  fi

  for role in default smol tiny vision execute task plan slow review_aux critical commit; do
    if grep -Eq "^[[:space:]]+$role:" "$cfg"; then info "ok: modelRoles.$role present"; else info "WARN: modelRoles.$role missing"; fi
  done

  if grep -Eq '^[[:space:]]+enableEffort:[[:space:]]+false' "$cfg"; then info "ok: task.enableEffort=false"; else info "NOTE: recommend task.enableEffort=false"; fi
  if grep -Eq '^[[:space:]]+maxConcurrency:[[:space:]]+3' "$cfg"; then info "ok: task.maxConcurrency=3"; else info "NOTE: recommend task.maxConcurrency=3"; fi
  if grep -Eq '^[[:space:]]+enabled:[[:space:]]+true' "$cfg" && grep -Eq '^isolation:' "$cfg"; then info "ok: task isolation appears enabled"; else info "NOTE: recommend task.isolation.enabled=true with isolation.backend=auto"; fi

  if command -v omp >/dev/null 2>&1; then
    info "omp: $(command -v omp)"
    omp --profile "$profile" config path 2>/dev/null || true
  else
    info "WARN: omp not found on PATH"
  fi
}

doctor() {
  each_profile : doctor_profile
}

usage() {
  printf 'usage: %s {install|verify|doctor}\n' "$0"
}

case ${1:-} in
  install) install ;;
  verify) verify ;;
  doctor) doctor ;;
  *) usage >&2; exit 2 ;;
esac
