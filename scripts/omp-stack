#!/usr/bin/env sh
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$HERE/.." && pwd)
ROOT=$(readlink -f "$ROOT")
if command -v omp >/dev/null 2>&1; then
  OMP_DIR=$(omp config path 2>/dev/null || printf '%s' "${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}")
else
  OMP_DIR=${PI_CODING_AGENT_DIR:-"$HOME/.omp/agent"}
fi

info() { printf '%s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }

link_owned() { # source dest
  src=$1 dst=$2
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    fail "$dst exists and is not a symlink; move/merge it manually"
  fi
  ln -sfn "$src" "$dst"
}

install() {
  mkdir -p "$OMP_DIR"
  for name in AGENTS.md agents rules skills extensions lib; do
    link_owned "$ROOT/agent/$name" "$OMP_DIR/$name"
    info "linked $OMP_DIR/$name -> $ROOT/agent/$name"
  done
  info "left $OMP_DIR/config.yml untouched; merge $ROOT/config.recommended.yml manually"
  info "left $OMP_DIR/mcp.json untouched; optional example: $ROOT/mcp.example.json"
}

verify_link() { # source dest
  src=$(readlink -f "$1")
  [ -L "$2" ] || { info "FAIL: $2 is not a symlink"; return 1; }
  dst=$(readlink -f "$2" 2>/dev/null || true)
  [ "$src" = "$dst" ] || { info "FAIL: $2 -> ${dst:-dangling}, expected $src"; return 1; }
  info "ok: $2"
}

verify() {
  rc=0
  for name in AGENTS.md agents rules skills extensions lib; do
    verify_link "$ROOT/agent/$name" "$OMP_DIR/$name" || rc=1
  done
  [ -f "$OMP_DIR/config.yml" ] && info "ok: config.yml present (user-owned)" || { info "WARN: $OMP_DIR/config.yml missing"; rc=1; }
  return "$rc"
}

doctor() {
  cfg="$OMP_DIR/config.yml"
  [ -f "$cfg" ] || fail "$cfg not found"

  info "config: $cfg"
  if grep -q 'ai-stack/.*/flow-skills\.ts\|ai-stack/omp/extensions/flow-skills\.ts' "$cfg"; then
    info "WARN: remove old ai-stack flow-skills.ts registration"
  else
    info "ok: no old flow-skills.ts registration"
  fi
  if grep -q 'ai-stack/shared/skills' "$cfg"; then
    info "WARN: remove old skills.customDirectories entry pointing at ai-stack/shared/skills"
  else
    info "ok: no old ai-stack shared-skills registration"
  fi
  if grep -q 'ai-stack/omp/extensions/ai-memory\.ts' "$cfg"; then
    info "WARN: explicit old ai-memory.ts path is redundant; native extensions/ auto-discovery owns it now"
  fi

  for role in task plan slow review_aux critical; do
    if grep -Eq "^[[:space:]]+$role:" "$cfg"; then info "ok: modelRoles.$role present"; else info "WARN: modelRoles.$role missing"; fi
  done

  if grep -Eq '^[[:space:]]+enableEffort:[[:space:]]+false' "$cfg"; then info "ok: task.enableEffort=false"; else info "NOTE: recommend task.enableEffort=false"; fi
  if grep -Eq '^[[:space:]]+maxConcurrency:[[:space:]]+3' "$cfg"; then info "ok: task.maxConcurrency=3"; else info "NOTE: recommend task.maxConcurrency=3"; fi
  if grep -Eq '^[[:space:]]+enabled:[[:space:]]+true' "$cfg" && grep -Eq '^isolation:' "$cfg"; then info "ok: task isolation appears enabled"; else info "NOTE: recommend task.isolation.enabled=true with isolation.backend=auto"; fi

  if command -v omp >/dev/null 2>&1; then
    info "omp: $(command -v omp)"
    omp config path 2>/dev/null || true
  else
    info "WARN: omp not found on PATH"
  fi
}

usage() {
  printf 'usage: %s {install|verify|doctor}\n' "$0"
}

case ${1:-} in
  install) install ;;
  verify) verify ;;
  doctor) doctor ;;
  *) usage >&2; exit 2 ;;
esac
